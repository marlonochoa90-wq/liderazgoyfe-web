---
import { SITE, REDES, NAV } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="bg-deep-950 text-ivory/80">
  <div class="container-page grid gap-12 py-16 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display text-2xl font-bold text-ivory">Liderazgo <span class="text-gold-400">&</span> Fe</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-ivory/60">{SITE.lema}</p>
      <div class="mt-6 flex gap-4">
        <a href={REDES.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-outline !px-4 !py-2 text-xs">WhatsApp</a>
        <a href={REDES.facebook} target="_blank" rel="noopener noreferrer" class="btn-outline !px-4 !py-2 text-xs">Facebook</a>
       
      </div>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-gold-400">Explora</p>
      <ul class="mt-4 space-y-2 text-sm">
        {NAV.slice(1).map((item) => (
          <li><a href={item.href} class="hover:text-gold-300 transition-colors">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-gold-400">Legal</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/politica-de-privacidad" class="hover:text-gold-300 transition-colors">Política de privacidad</a></li>
        <li><a href="/peticiones-de-oracion" class="hover:text-gold-300 transition-colors">Peticiones de oración</a></li>
        <li><a href="/rss.xml" class="hover:text-gold-300 transition-colors">RSS</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ivory/10 py-6">
    <p class="container-page text-center text-xs text-ivory/40">
      © {year} {SITE.nombre}. Todos los derechos reservados.
    </p>
  </div>
</footer>
