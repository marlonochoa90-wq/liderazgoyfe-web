---
import { NAV, SITE } from '@/lib/site';
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-deep-900/5 bg-ivory/80 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between md:h-20">
    <a href="/" class="flex items-center gap-2 group">
      <span class="font-display text-xl md:text-2xl font-bold text-deep-900 tracking-tight">
        Liderazgo <span class="text-gold-500">&</span> Fe
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-medium tracking-wide transition-colors duration-300 ease-apple hover:text-gold-600',
            currentPath === item.href ? 'text-gold-600' : 'text-deep-700',
          ]}
target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <a href="/peticiones-de-oracion" class="btn-gold">Pide oración</a>
    </div>

    <button
      id="menu-toggle"
      class="md:hidden inline-flex items-center justify-center rounded-full p-2 text-deep-900"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="md:hidden hidden flex-col gap-1 border-t border-deep-900/5 bg-ivory px-6 pb-6 pt-2"
    aria-label="Navegación móvil"
  >
    {NAV.map((item) => (
      <a
        href={item.href}
        class:list={[
          'rounded-lg px-3 py-3 text-base font-medium transition-colors',
          currentPath === item.href ? 'bg-gold-50 text-gold-700' : 'text-deep-800 hover:bg-deep-50',
        ]}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
      >
        {item.label}
      </a>
    ))}
    <a href="/peticiones-de-oracion" class="btn-gold mt-3 w-full">Pide oración</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('flex');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
