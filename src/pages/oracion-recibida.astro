---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Petición recibida" description="Tu petición de oración ha sido recibida." noindex={true}>
  <section class="flex min-h-[60vh] items-center justify-center py-24 text-center">
    <div class="container-page max-w-xl">
      <h1 class="section-title">Tu petición ha sido recibida.</h1>
      <p class="mt-4 text-deep-600">Estaremos orando por ti. Dios te bendiga.</p>
      <a href="/" class="btn-primary mt-8 inline-flex">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
