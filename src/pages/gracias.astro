---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Gracias" description="Hemos recibido tu mensaje." noindex={true}>
  <section class="flex min-h-[60vh] items-center justify-center py-24 text-center">
    <div class="container-page max-w-xl">
      <h1 class="section-title">¡Gracias!</h1>
      <p class="mt-4 text-deep-600">Hemos recibido tu mensaje. Nuestro equipo lo revisará pronto.</p>
      <a href="/" class="btn-primary mt-8 inline-flex">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
