---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { REDES } from '@/lib/site';
---

<BaseLayout
  title="Peticiones de oración"
  description="Comparte tu petición de oración con nuestra comunidad. Creemos en el poder de la oración en comunidad."
>
  <section class="bg-deep-950 py-20 text-center text-ivory">
    <div class="container-page">
      <h1 class="font-display text-4xl md:text-5xl">Peticiones de oración</h1>
      <p class="mx-auto mt-4 max-w-xl text-ivory/70">
        "Orando en todo tiempo con toda oración y súplica en el Espíritu" — Efesios 6:18. Cuéntanos cómo podemos orar por ti.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="container-page max-w-2xl">
        <div class="rounded-2xl border border-deep-900/10 bg-white p-8 text-center shadow-sm sm:p-10">
          <p class="text-deep-600">
            Comparte tu petición de oración directamente con nuestra comunidad. Únete al grupo de WhatsApp, cuéntanos cómo podemos orar por ti, y nuestro equipo la recibirá con cariño y confidencialidad.
          </p>
          <a href={REDES.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-gold mt-8 inline-flex w-full sm:w-auto">
            Unirme al grupo y compartir mi petición
          </a>
        </div>
    </div>
  </section>
</BaseLayout>
