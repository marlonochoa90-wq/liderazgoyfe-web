---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const recursos = (await getCollection('recursos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
---

<BaseLayout title="Recursos" description="Descarga PDFs, guías y libros gratuitos sobre liderazgo y crecimiento espiritual.">
  <section class="bg-deep-950 py-20 text-center text-ivory">
    <div class="container-page">
      <h1 class="font-display text-4xl md:text-5xl">Recursos</h1>
      <p class="mx-auto mt-4 max-w-xl text-ivory/70">Materiales descargables para tu crecimiento personal y el de tu equipo.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {recursos.map((r) => (
        <div class="card flex flex-col overflow-hidden">
          {r.data.portada && (
            <div class="aspect-[4/3] w-full overflow-hidden bg-deep-100">
              <img src={r.data.portada} alt={r.data.title} loading="lazy" class="h-full w-full object-cover" />
            </div>
          )}
          <div class="flex flex-1 flex-col p-6">
            <span class="badge bg-gold-100 text-gold-800 w-fit">{r.data.tipo}</span>
            <h2 class="mt-3 font-display text-xl text-deep-900">{r.data.title}</h2>
            <p class="mt-2 flex-1 text-sm text-deep-600">{r.data.description}</p>
            {r.data.paginas && <p class="mt-3 text-xs text-deep-400">{r.data.paginas} páginas</p>}
            {r.data.archivoUrl.includes("guia-devocional-30-dias") ? (
                <span class="badge bg-deep-100 text-deep-500 mt-5 w-fit">Próximamente disponible</span>
              ) : (
                <a href={r.data.archivoUrl} download class="btn-primary mt-5">Descargar</a>
              )}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
