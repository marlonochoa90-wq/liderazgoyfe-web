---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIA_COLOR } from '@/lib/site';

const estudios = (await getCollection('estudios', ({ data }) => !data.draft))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
---

<BaseLayout title="Estudios" description="Estudios bíblicos temáticos por lecciones sobre liderazgo, fe y desarrollo personal.">
  <section class="bg-deep-950 py-20 text-center text-ivory">
    <div class="container-page">
      <h1 class="font-display text-4xl md:text-5xl">Estudios</h1>
      <p class="mx-auto mt-4 max-w-xl text-ivory/70">
        Profundiza con estudios estructurados por lecciones, ideales para uso personal o en grupos pequeños.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-page grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {estudios.map((e) => (
        <div class="card overflow-hidden">
          {e.data.imagen && (
            <div class="aspect-[16/10] w-full overflow-hidden bg-deep-100">
              <img src={e.data.imagen} alt={e.data.title} loading="lazy" class="h-full w-full object-cover" />
            </div>
          )}
          <div class="p-6">
            <div class="flex items-center gap-2 text-xs">
              <span class:list={['badge', CATEGORIA_COLOR[e.data.categoria]]}>{e.data.categoria}</span>
              <span class="text-deep-400">{e.data.nivel}</span>
            </div>
            <h2 class="mt-3 font-display text-xl text-deep-900">{e.data.title}</h2>
            <p class="mt-2 text-sm text-deep-600">{e.data.description}</p>
            <p class="mt-4 text-xs uppercase tracking-wider text-deep-400">{e.data.numeroLecciones} lecciones</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
